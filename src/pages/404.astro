---
// Port of routes/_404.tsx — verbatim copy, title and /logo.svg reference
// preserved (MIGRATION_INVENTORY.md §12 parity checklist: title
// "404 - Page not found", custom 404 returns status 404).
import Base from "../layouts/Base.astro";

Astro.response.status = 404;
---

<Base title="404 - Page not found">
  <div class="px-4 py-8 mx-auto bg-[#86efac]">
    <div class="max-w-screen-md mx-auto flex flex-col items-center justify-center">
      <img
        class="my-6"
        src="/logo.svg"
        width="128"
        height="128"
        alt="the Fresh logo: a sliced lemon dripping with juice"
      />
      <h1 class="text-4xl font-bold">404 - Page not found</h1>
      <p class="my-4">
        The page you were looking for doesn't exist.
      </p>
      <a href="/" class="underline">Go back home</a>
    </div>
  </div>
</Base>
