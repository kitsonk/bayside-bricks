{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Base Workers configuration. The @astrojs/cloudflare adapter reads this at
  // build time and emits a resolved config at dist/server/wrangler.json —
  // `wrangler dev` / `wrangler deploy` run against THAT (see package.json
  // scripts). Keep secrets out of this file.
  "name": "bayside-bricks",
  // Pinned; must not exceed the bundled workerd's supported date — bump it
  // deliberately when the wrangler/workerd toolchain advances.
  "compatibility_date": "2026-11-03",
  // nodejs_compat makes the Worker env bindings readable via process.env,
  // which is how src/lib/env.ts resolves runtime configuration.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Production hostname, declared here so the binding is reproducible: a
  // `wrangler deploy` of this config attaches bricks.kitandsimon.com to the
  // `bayside-bricks` Worker (creating the proxied DNS record and certificate
  // request) instead of relying on a one-off dashboard/API step. The adapter
  // copies `routes` verbatim into dist/server/wrangler.json, which is the
  // config CI deploys.
  //
  // Deploying this route does NOT require the zone to be active: a deploy
  // against the still-pending kitandsimon.com zone succeeds and the hostname
  // serves as soon as the registrar points at Cloudflare's nameservers.
  // `workers_dev` stays enabled (default) — the workers.dev host is the
  // pre-cutover production target and the rollback surface.
  //
  // Preview deployments are unaffected: `wrangler versions upload` ignores
  // triggers and never moves production traffic or routes.
  "routes": [
    { "pattern": "bricks.kitandsimon.com", "custom_domain": true }
  ],
  // Non-secret configuration goes here and is readable via env("NAME") at
  // runtime (or import.meta.env.NAME at build time):
  // "vars": {
  //   "APP_ENV": "production"
  // }
}
