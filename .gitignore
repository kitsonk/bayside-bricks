# dotenv environment variable files
.env
.env.*
!.env.example
# Wrangler local dev secrets (never committed; .dev.vars.example is the template)
.dev.vars

# npm dependencies
node_modules/

# Astro build output and caches
dist/
.astro/

# Wrangler state (.wrangler/deploy, .wrangler/dry-run, local .dev.vars state)
.wrangler/

# CI step logs (`.github/workflows/ci.yml` tees every step to ci-*.log)
ci-*.log

# Kanban worker worktrees created inside the repo
.worktrees/
